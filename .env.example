# Supabase — só a anon key no front (leitura pública via RLS). Ver plan §7.
# Copie para .env (git-ignored) e preencha. Configure também no painel da Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Ambiente por schema: dev (local) | hml (homologação) | prd (produção).
# Local usa dev. No deploy, defina por ambiente na Vercel (Preview=hml, Production=prd).
VITE_SUPABASE_SCHEMA=dev
